# Copy this file to .env in the project root and fill in real values.
# Never commit the real .env file.

# --- Django core ---
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,your-domain.com

# --- Database (MySQL) ---
# Set DB_ENGINE=sqlite to use a local sqlite file instead (dev/testing only).
DB_ENGINE=mysql
DB_NAME=portfolio_db
DB_USER=portfolio_user
DB_PASSWORD=replace-with-a-strong-password
DB_HOST=127.0.0.1
DB_PORT=3306

# --- CORS / CSRF (comma separated, no trailing slash) ---
CORS_ALLOWED_ORIGINS=https://ajitmene.github.io
CSRF_TRUSTED_ORIGINS=https://ajitmene.github.io

# --- Production TLS ---
SECURE_SSL_REDIRECT=True
